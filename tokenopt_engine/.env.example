GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Conservative free-tier pacing defaults for agentic tests.
# Lower these if you hit 429 TPM/RPM limits.
GROQ_SAFE_TPM="9000"
GROQ_SAFE_RPM="20"
GROQ_REQUEST_GAP_SECONDS="8"

# Default fallback optimizer config.
TOKENOPT_MODE="balanced"
TOKENOPT_MAX_INPUT_TOKENS="3500"
TOKENOPT_MIN_RETENTION="0.86"

# Optional agent-specific overrides. Leave commented unless tuning.
# TOKENOPT_RESUMEINTELLIGENCEAGENT_MODE="balanced"
# TOKENOPT_RESUMEINTELLIGENCEAGENT_RETENTION="0.86"
# TOKENOPT_JDREQUIREMENTAGENT_MODE="balanced"
# TOKENOPT_SEMANTICFITSCORINGAGENT_MODE="conservative"
# TOKENOPT_INTERVIEWQUESTIONAGENT_MODE="aggressive"
# TOKENOPT_RECRUITERDECISIONAGENT_MODE="conservative"
